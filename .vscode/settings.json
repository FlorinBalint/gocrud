{
  "go.goroot": "${workspaceFolder}/bazel-${workspaceFolderBasename}/external/rules_go++go_sdk+main___download_0/",
  "gopls": {
    "build.env": {
      "GOPACKAGESDRIVER": "./gopackagesdriver.sh"
    },
    "build.workspaceFiles": [
      "**/BUILD",
      "**/BUILD.bazel",
      "**/WORKSPACE",
      "**/MODULE.bazel",
      "**/*.{bzl,bazel}"
    ],
    "build.directoryFilters": [
      "-bazel-bin",
      "-bazel-out",
      "-bazel-testlogs",
      "-bazel-${workspaceFolderBasename}"
    ],
    "build.buildFlags": [
      "-tags=bazel"
    ]
  },
  "go.useLanguageServer": true,
  "bazel.buildifierExecutable": "buildifier",
  "go.languageServerFlags": [
    "-remote=auto",
    "-logfile=auto",
    "-debug=:0"
  ]
}
